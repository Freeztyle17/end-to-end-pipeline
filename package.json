{
  "name": "end-to-end-pipeline",
  "version": "1.0.0",
  "description": "End-to-end CI/CD demo: commit → CI → tests → Docker → K8s → S3 → tracker",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:ci": "jest --coverage --ci",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Freeztyle17/end-to-end-pipeline.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Freeztyle17/end-to-end-pipeline/issues"
  },
  "homepage": "https://github.com/Freeztyle17/end-to-end-pipeline#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    }
  },
  "engines": {
    "node": ">=20"
  }
}
